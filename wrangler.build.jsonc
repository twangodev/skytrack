// Adapter-facing config only: @sveltejs/adapter-cloudflare emits its worker
// to this file's `main`. Production deploys use the root wrangler.jsonc,
// whose `main` wraps the emitted worker with the scheduled handler.
// compatibility_flags here intentionally stays "nodejs_als" and diverges from
// root's "nodejs_compat" - the adapter never reads this field, so it's build
// time only (see root wrangler.jsonc's top comment).
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "skytrack-site",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_als"],
	"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "skytrack",
			"database_id": "7188bd2c-07c4-419b-9c37-ae7e186452f9"
		}
	],
	"observability": { "enabled": true }
}
