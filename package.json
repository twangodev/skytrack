{
	"name": "skytrack",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:host": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && bun run check:worker",
		"check:worker": "tsc --noEmit -p worker",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"test": "vitest run",
		"test:workers": "cd workers/pipeline && bunx vitest run",
		"db:migrate:local": "cd workers/pipeline && bunx wrangler d1 migrations apply skytrack --local --persist-to ../../.wrangler/state",
		"db:seed:local": "cd workers/pipeline && bunx wrangler dev --test-scheduled --var BOOTSTRAP:1 --persist-to ../../.wrangler/state",
		"icons": "bun scripts/generate-icons.ts"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.21.0",
		"@cloudflare/workers-types": "^5.20260810.1",
		"@icons-pack/svelte-simple-icons": "^7.2.0",
		"@lucide/svelte": "^0.575.0",
		"@number-flow/svelte": "^0.4.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.57.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.2",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.8",
		"@types/node": "^24",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"layerchart": "^1.0.13",
		"mode-watcher": "^1.1.0",
		"png-to-ico": "^3.0.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"prismarine-nbt": "^2.7.0",
		"schema-dts": "^1.1.5",
		"sharp": "^0.34.0",
		"svelte": "^5.55.4",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.1.8",
		"wrangler": "^4.120.1",
		"zod": "^4.4.3"
	}
}
