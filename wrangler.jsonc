// Production/deploy config. Build-time worker generation is handled by a
// separate config (wrangler.build.jsonc, wired via svelte.config.js's
// `adapter({ config: ... })`) because @sveltejs/adapter-cloudflare writes its
// generated worker to whatever `main` its config names - pointing it at this
// file would make it overwrite worker/index.ts instead of emitting
// .svelte-kit/cloudflare/_worker.js. This file's `main` (worker/index.ts)
// imports that emitted worker and adds the scheduled handler; see
// workers/pipeline/src/crons.test.ts for a config-drift guard between the two.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "skytrack-site",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
	"triggers": { "crons": ["*/5 * * * *", "10 */3 * * *", "30 4 * * *"] },
	// Applies to every invocation, including HTTP requests, not just the
	// crons - user-accepted tradeoff so the auction crawl (the heaviest cron)
	// fits within one Worker's limits.
	"limits": { "cpu_ms": 300000 },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "skytrack",
			"database_id": "7188bd2c-07c4-419b-9c37-ae7e186452f9",
			"migrations_dir": "workers/pipeline/migrations"
		}
	],
	"observability": { "enabled": true }
}
